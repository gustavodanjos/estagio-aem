{
  "alloworigin": [
    "http://localhost:3000",
    "http://localhost:8080"
  ],
  "allowedpaths": [
    "/(content|conf)/wknd.*",
    "/content/dam/wknd/.*",
    "/graphql/execute.json/.*"
  ],
  "supportedheaders": [
    "Authorization",
    "Origin",
    "Accept",
    "X-Requested-With",
    "Content-Type",
    "Access-Control-Request-Method",
    "Access-Control-Request-Headers"
  ],
  "supportedmethods": [
    "GET",
    "HEAD",
    "POST",
    "OPTIONS"
  ],
  "alloworiginregexp": [
    "http://localhost:.*"
  ],
  "supportscredentials": true
}