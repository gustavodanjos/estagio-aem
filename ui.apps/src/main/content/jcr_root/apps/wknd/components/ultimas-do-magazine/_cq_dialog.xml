<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Últimas do Magazine"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <properties
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Configuração de Exibição"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <rootPath
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="Pasta Raiz dos Artigos"
                                                fieldDescription="Selecione a pasta do AEM onde estão as páginas de artigos que devem ser listadas aqui (ex.: /content/wknd/us/en/magazine). O componente buscará todas as páginas filhas dessa pasta e listará as mais recentes."
                                                name="./rootPath"
                                                rootPath="/content/wknd"
                                                required="{Boolean}true"/>
                                            <maxItems
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                fieldLabel="Quantidade de Artigos Exibidos"
                                                fieldDescription="Defina quantos artigos recentes devem aparecer na página (padrão: 4). Escolha um valor entre 1 e 12."
                                                name="./maxItems"
                                                defaultValue="4"
                                                value="4"
                                                min="1"
                                                max="12"
                                                step="1"/>
                                            <gridColumns
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Tamanho do Grid (Colunas)"
                                                fieldDescription="Selecione quantas colunas o grid de artigos terá (1 a 6 colunas)."
                                                name="./columns"
                                                value="4">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <col1 jcr:primaryType="nt:unstructured" text="1 Coluna" value="1"/>
                                                    <col2 jcr:primaryType="nt:unstructured" text="2 Colunas" value="2"/>
                                                    <col3 jcr:primaryType="nt:unstructured" text="3 Colunas" value="3"/>
                                                    <col4 jcr:primaryType="nt:unstructured" text="4 Colunas (Padrão)" value="4"/>
                                                    <col5 jcr:primaryType="nt:unstructured" text="5 Colunas" value="5"/>
                                                    <col6 jcr:primaryType="nt:unstructured" text="6 Colunas" value="6"/>
                                                </items>
                                            </gridColumns>
                                            <adventuresPath
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="Pasta Raiz das Aventuras"
                                                fieldDescription="Selecione a pasta do AEM onde estão os Content Fragments de Aventuras (ex.: /content/dam/wknd)."
                                                name="./adventuresPath"
                                                rootPath="/content/dam"
                                                required="{Boolean}true"/>
                                            <maxAdventures
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                fieldLabel="Quantidade de Aventuras Exibidas"
                                                fieldDescription="Defina quantas aventuras recentes devem aparecer misturadas aos artigos (padrão: 2)."
                                                name="./maxAdventures"
                                                defaultValue="2"
                                                value="2"
                                                min="0"
                                                max="6"
                                                step="1"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </properties>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
